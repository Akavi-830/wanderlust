
<% layout("/layouts/boilerplate") %>

<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
    }

    .filter {
        text-align: center;
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        opacity: 0.65;
        text-decoration: none;
        color: inherit;
        transition: opacity 0.15s, background 0.15s;
        min-width: 60px;
    }

    .filter:hover {
        opacity: 1;
        background: #f5f5f5;
        color: inherit;
        text-decoration: none;
    }

    .filter.active {
        opacity: 1;
        border-bottom: 2px solid black;
        font-weight: 600;
    }

    .filter p {
        margin: 0.25rem 0 0;
        font-size: 0.75rem;
    }

    .switch-toggle {
        border: 1px solid black;
        border-radius: 1rem;
        height: 2.5rem;
        padding: 0.4rem;
        margin-left: auto;
        display: flex;
        align-items: center;
    }

    .tax-info {
        display: none;
    }

    .no-results {
        text-align: center;
        padding: 3rem;
        color: #888;
    }
</style>

<div id="filters">

    <a href="/listings" class="filter <%= !currCategory ? 'active' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </a>

    <a href="/listings?category=Room" class="filter <%= currCategory === 'Room' ? 'active' : '' %>">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Room</p>
    </a>

    <a href="/listings?category=Iconic%20Cities" class="filter <%= currCategory === 'Iconic Cities' ? 'active' : '' %>">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </a>

    <a href="/listings?category=Mountains" class="filter <%= currCategory === 'Mountains' ? 'active' : '' %>">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </a>

    <a href="/listings?category=Castles" class="filter <%= currCategory === 'Castles' ? 'active' : '' %>">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </a>

    <a href="/listings?category=Pools" class="filter <%= currCategory === 'Pools' ? 'active' : '' %>">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Pools</p>
    </a>

    <a href="/listings?category=Camping" class="filter <%= currCategory === 'Camping' ? 'active' : '' %>">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </a>

    <a href="/listings?category=Farms" class="filter <%= currCategory === 'Farms' ? 'active' : '' %>">
        <div><i class="fa-solid fa-tractor"></i></div>
        <p>Farms</p>
    </a>

    <a href="/listings?category=Arctic" class="filter <%= currCategory === 'Arctic' ? 'active' : '' %>">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </a>

    <a href="/listings?category=Boat" class="filter <%= currCategory === 'Boat' ? 'active' : '' %>">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boat</p>
    </a>

    <a href="/listings?category=Beach" class="filter <%= currCategory === 'Beach' ? 'active' : '' %>">
        <div><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Beach</p>
    </a>

    <div class="switch-toggle">
        <div class="form-check-reverse form-switch">
            <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="switchCheckDefault"
            >
            <label
                class="form-check-label"
                for="switchCheckDefault"
            >
                Display total tax
            </label>
        </div>
    </div>

</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">

    <% if (allListings.length === 0) { %>
        <div class="no-results col-12">
            <% if (currSearch) { %>
                <h5>No listings found for "<%= currSearch %>"</h5>
            <% } else { %>
                <h5>No listings found in "<%= currCategory %>"</h5>
            <% } %>
            <a href="/listings">View all listings</a>
        </div>
    <% } %>

    <% for(let listing of allListings){ %>

        <div class="col">

            <a
                href="/listings/<%= listing._id %>"
                class="listing-link"
            >

                <div class="card listing-card">

                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top"
                        alt="listing_image"
                        style="height:20rem;"
                    >

                    <div class="card-img-overlay"></div>

                    <div class="card-body">

                        <p class="card-text">
                            <b><%= listing.title %></b>
                            <br>

                            ₹ <%= listing.price.toLocaleString("en-IN") %>/night

                            <i class="tax-info">
                                +18% GST
                            </i>
                        </p>

                    </div>

                </div>

            </a>

        </div>

    <% } %>

</div>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");

    taxSwitch.addEventListener("click", () => {

        let taxInfo =
            document.getElementsByClassName("tax-info");

        for(let info of taxInfo){

            if(info.style.display !== "inline"){
                info.style.display = "inline";
            }else{
                info.style.display = "none";
            }

        }

    });
</script>
