<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
  <div class="card shadow-lg border-0 profile-card">
    <div class="card-body p-3 p-md-5">
      <div class="text-center mb-4">
        <div class="profile-avatar">
          <%= user.username.charAt(0).toUpperCase() %>
        </div>

        <h2 class="mt-3">@<%= user.username %></h2>
      </div>

      <hr />

      <div class="row mt-4">
        <div class="col-md-6">
          <p><strong>Email:</strong> <%= user.email %></p>

          <p>
            <strong>Joined:</strong>
            <%= user.createdAt ? user.createdAt.toDateString() : "Not Available"
            %>
          </p>
        </div>

        <div class="col-md-6">
          <p>
            <strong>Total Listings:</strong>
            <%= myListings.length%>
          </p>

          <p>
            <strong>Wishlist Items:</strong>
            <%= user.wishlist.length %>
          </p>
          <hr>

<h3 class="mt-4">
  My Bookings
</h3>
<div class="row g-4 mt-3">

<% if(myBookings.length === 0){ %>

<div class="text-center py-3">
  <p class="text-muted">
    No bookings yet.
  </p>
</div>

<% } %>


<% myBookings.forEach((booking)=>{ %>
  <div class="col-12 col-md-6">


  <div class="card shadow border-0 rounded-4 booking-card h-100">
  <div class="card-body p-4">
    
    <h5 class="fw-bold mb-3">
      <i class="fa-solid fa-calendar-check me-2 text-success"></i>
      <%= booking.listing.title %>
    </h5>

    <div class="mb-2">
      <span class="badge bg-primary">Check In</span>
      <span><%= booking.checkIn.toDateString() %></span>
    </div>

    <div class="mb-2">
      <span class="badge bg-info">Check Out</span>
      <span><%= booking.checkOut.toDateString() %></span>
    </div>

    <div class="mb-2">
      <span class="badge bg-warning text-dark">Guests</span>
      <span><%= booking.guests %></span>
    </div>

    <hr>

    <h5 class="text-danger fw-bold">
      ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
    </h5>

  </div>
</div>
</div>

  

 

<% }) %>
</div>
        </div>
      </div>
    </div>
  </div>
</div>
